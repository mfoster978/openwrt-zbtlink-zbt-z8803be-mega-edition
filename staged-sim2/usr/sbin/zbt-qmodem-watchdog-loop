#!/bin/sh
# Keep the QModem profile for a physically enumerated Z8803BE modem aligned
# with its network and firewall state. The board has two independent M.2 power
# GPIOs: 4-1/5G1 is the default slot and 2-1/5G2 is operator-selected. Never
# infer an active slot from a pre-seeded UCI section; act only on a live USB
# path so a selected 5G2 modem cannot cause 5G1 to be re-powered or redialed.

POLL_INTERVAL_FAST="${POLL_INTERVAL_FAST:-5}"
POLL_INTERVAL_SLOW="${POLL_INTERVAL_SLOW:-30}"
FAST_PHASE_SECS="${FAST_PHASE_SECS:-60}"
SETTLE_DELAY="${SETTLE_DELAY:-15}"
# Minimum gap between two UCI-writing passes for the same section while the
# link still looks healthy. See REASSERT THROTTLE in reassert_section().
REASSERT_MIN_INTERVAL="${REASSERT_MIN_INTERVAL:-120}"
RUNDIR=/tmp/zbt-watchdog
NAME=zbt-qmodem-watchdog

is_active_rndis() {
	local netdev driver dev
	for netdev in /sys/class/net/*; do
		[ -e "$netdev" ] || continue
		driver="$(basename "$(readlink -f "$netdev/device/driver" 2>/dev/null)")"
		[ "$driver" = rndis_host ] && return 0
	done
	return 1
}

find_wan_zone() {
	local sec
	for sec in $(uci -q show firewall | sed -nE 's/^firewall\.(@zone\[[0-9]+\])=zone$/\1/p'); do
		[ "$(uci -q get "firewall.$sec.name")" = wan ] && printf '%s\n' "$sec" && return 0
	done
	return 1
}

slot_power() {
	case "$1" in
		4_1) printf '%s\n' 5g1 ;;
		2_1) printf '%s\n' 5g2 ;;
	esac
}

section_device() {
	local path net
	path="$(uci -q get "qmodem.$1.path")"
	[ -d "$path" ] || return 1
	for net in "$path"/*/net/* "$path"/*/*/net/*; do
		[ -e "$net" ] && basename "$net" && return 0
	done
	return 1
}

configured_metric() {
	local value
	value="$(uci -q get "qmodem.$1.metric")"
	case "$value" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "${#value}" -le 5 ] && [ "$value" -le 65535 ] || return 1
	printf '%s\n' "$value"
}

physical_device() {
	local path candidate driver found count=0
	case "$1" in
		4_1) path=/sys/bus/usb/devices/4-1 ;;
		2_1) path=/sys/bus/usb/devices/2-1 ;;
		*) return 1 ;;
	esac
	[ -d "$path" ] || return 1
	for candidate in "$path"/*/net/*; do
		[ -d "$candidate" ] || continue
		driver="$(readlink -f "${candidate%/net/*}/driver")" || return 1
		[ "${driver##*/}" = qmi_wwan ] || continue
		found="${candidate##*/}"
		count=$((count + 1))
	done
	[ "$count" = 1 ] || return 1
	case "$found" in ''|*[!A-Za-z0-9_.-]*) return 1 ;; esac
	[ "${#found}" -le 15 ] || return 1
	printf '%s\n' "$found"
}

# Enumeration is not proof of SIM readiness. Never activate from this helper.
prepare_sim2_offline() {
	local device metric spec key value dirty=0
	device="$(physical_device 2_1)" || return 1
	metric="$(configured_metric 2_1)" || return 1
	# Preparation must not silently select a route preference supplied by old defaults.
	[ "$metric" = 210 ] || return 1
	for spec in \
		"2_1=interface" "2_1.proto=dhcp" "2_1.device=$device" \
		"2_1.ifname=$device" "2_1.modem_config=2_1" "2_1.metric=$metric" \
		"2_1.auto=0" "2_1.disabled=1" "2_1.defaultroute=0" "2_1.peerdns=0" \
		"2_1v6=interface" "2_1v6.proto=dhcpv6" "2_1v6.device=@2_1" \
		"2_1v6.modem_config=2_1" "2_1v6.metric=$metric" \
		"2_1v6.auto=0" "2_1v6.disabled=1" "2_1v6.defaultroute=0"
	do
		key=${spec%%=*}
		value=${spec#*=}
		if [ "$(uci -q get "network.$key")" != "$value" ]; then
			uci -q set "network.$key=$value" || return 1
			dirty=1
		fi
	done
	[ "$dirty" = 0 ] || uci -q commit network
	# No runtime reload, ifup, firewall reload, GPIO or modem control.
}

active_sections() {
	local sec path slot
	for sec in $(uci -q show qmodem | sed -nE 's/^qmodem\.([^.=]+)=modem-device$/\1/p'); do
		case "$sec" in 4_1|2_1) ;; *) continue ;; esac
		path="$(uci -q get "qmodem.$sec.path")"
		slot="${sec/_/-}"
		[ -d "$path" ] && [ "$(basename "$path")" = "$slot" ] && printf '%s\n' "$sec"
	done
}

link_healthy() {
	local sec="$1" device="$2"
	ip -4 addr show "$device" 2>/dev/null | grep -q 'inet ' || return 1
	ubus call "network.interface.$sec" status 2>/dev/null | grep -q '"up": true' || return 1
	return 0
}

# REASSERT THROTTLE. A healthy link that merely disagrees with our preferred
# proto/metric is not an emergency: QModem owns those fields and will keep
# writing its own view, so chasing it every 5 s produces commits, which produce
# reloads, which produce redials. Only act immediately when the link is
# genuinely down or unaddressed; otherwise rate-limit the writes per section.
recently_asserted() {
	local sec="$1" last now
	last=$(cat "$RUNDIR/last-assert.$sec" 2>/dev/null) || return 1
	case "$last" in ''|*[!0-9]*) return 1 ;; esac
	now=$(awk '{print int($1)}' /proc/uptime)
	[ $((now - last)) -lt "$REASSERT_MIN_INTERVAL" ]
}

mark_asserted() {
	awk '{print int($1)}' /proc/uptime > "$RUNDIR/last-assert.$1"
}

reassert_section() {
	local sec="$1" power device zone metric changed=1
	local network_changed=0 firewall_changed=0
	power="$(slot_power "$sec")"
	if [ "$sec" = 2_1 ]; then
		prepare_sim2_offline
		return 1
	fi
	device="$(section_device "$sec")" || return 1
	metric="$(configured_metric "$sec")" || return 1

	if recently_asserted "$sec" && link_healthy "$sec" "$device"; then
		return 1
	fi

	# The physically enumerated slot alone may be held on. Do not touch its peer.
	if [ -w "/sys/class/gpio/$power/value" ] && [ "$(cat "/sys/class/gpio/$power/value" 2>/dev/null)" != 1 ]; then
		printf 1 > "/sys/class/gpio/$power/value"
		changed=0
	fi
	if [ "$(uci -q get "qmodem.$sec.state")" = disabled ]; then
		uci -q set "qmodem.$sec.state=enabled"
		uci -q commit qmodem
		changed=0
	fi

	# Respect the QModem-owned configured metric; never force it.

# proto must match what QModem's set_if() would itself choose for this
# modem: 'dhcp' for a Quectel dialing QMI. See 32-zbt-z8803be-wan-failover.
	for spec in \
		"$sec=interface" "${sec}.proto=dhcp" "${sec}.device=$device" \
		"${sec}.ifname=$device" "${sec}.metric=$metric" \
		"${sec}.defaultroute=1" "${sec}.peerdns=0" \
		"${sec}v6=interface" "${sec}v6.proto=dhcpv6" \
		"${sec}v6.device=$device" "${sec}v6.metric=$metric" \
		"${sec}v6.disabled=1"
	do
		key=${spec%%=*}
		value=${spec#*=}
		if [ "$(uci -q get "network.$key")" != "$value" ]; then
			uci -q set "network.$key=$value"
			network_changed=1
		fi
	done
	if [ "$sec" = 2_1 ]; then
		for iface in "$sec" "${sec}v6"; do
			if [ "$(uci -q get "network.$iface.modem_config")" != "$sec" ]; then
				uci -q set "network.$iface.modem_config=$sec"
				network_changed=1
			fi
		done
	fi
	if [ "$network_changed" = 1 ]; then
		uci -q commit network
		changed=0
	fi

	if zone="$(find_wan_zone)"; then
		firewall_changed=0
		for iface in "$sec" "${sec}v6"; do
			case " $(uci -q get "firewall.$zone.network") " in
				*" $iface "*) ;;
				*) uci -q add_list "firewall.$zone.network=$iface"; firewall_changed=1 ;;
			esac
		done
		if [ "$firewall_changed" = 1 ]; then
			uci -q commit firewall
			changed=0
		fi
	fi

	mark_asserted "$sec"

	ip -4 addr show "$device" 2>/dev/null | grep -q 'inet ' || return "$changed"
	if ! ubus call "network.interface.$sec" status 2>/dev/null | grep -q '"up": true'; then
		ifup "$sec" >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1
		changed=0
	fi
	return "$changed"
}

mkdir -p "$RUNDIR"
# Measure the fast phase from the first ever run, not from this process's
# start. The loop is respawned by procd on config edits, and re-arming the
# 5 s cadence on every respawn kept it polling at boot speed indefinitely.
[ -s "$RUNDIR/boot_ts" ] || awk '{print int($1)}' /proc/uptime > "$RUNDIR/boot_ts"

sleep "$SETTLE_DELAY"
start_ts=$(cat "$RUNDIR/boot_ts")
while :; do
	if ! is_active_rndis && [ "$(uci -q get qmodem.main.block_auto_probe)" != 1 ] && [ "$(uci -q get qmodem.main.enable_dial)" = 1 ]; then
		changed=1
		for sec in $(active_sections); do reassert_section "$sec" && changed=0; done
		[ "$changed" = 0 ] && fw4 reload >/dev/null 2>&1
	fi
	now_ts=$(awk '{print int($1)}' /proc/uptime)
	if [ $((now_ts - start_ts)) -lt "$FAST_PHASE_SECS" ]; then sleep "$POLL_INTERVAL_FAST"; else sleep "$POLL_INTERVAL_SLOW"; fi
done
