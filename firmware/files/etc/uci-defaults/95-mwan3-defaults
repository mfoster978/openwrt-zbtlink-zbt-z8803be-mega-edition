#!/bin/sh
set -eu

network_exists() {
	uci -q get "network.$1" >/dev/null 2>&1
}

configure_tracking() {
	interface="$1"
	track_ip_1="$2"
	track_ip_2="$3"
	uci -q set "mwan3.$interface=interface"
	uci -q set "mwan3.$interface.enabled=1"
	uci -q set "mwan3.$interface.initial_state=online"
	uci -q set "mwan3.$interface.family=ipv4"
	uci -q set "mwan3.$interface.track_method=ping"
	uci -q set "mwan3.$interface.reliability=1"
	uci -q set "mwan3.$interface.count=1"
	uci -q set "mwan3.$interface.size=56"
	uci -q set "mwan3.$interface.max_ttl=60"
	uci -q set "mwan3.$interface.timeout=2"
	uci -q set "mwan3.$interface.interval=5"
	uci -q set "mwan3.$interface.down=3"
	uci -q set "mwan3.$interface.up=2"
	uci -q del "mwan3.$interface.track_ip" 2>/dev/null || true
	uci -q add_list "mwan3.$interface.track_ip=$track_ip_1"
	uci -q add_list "mwan3.$interface.track_ip=$track_ip_2"
}

configure_member() {
	member="$1"
	interface="$2"
	metric="$3"
	weight="$4"
	uci -q set "mwan3.$member=member"
	uci -q set "mwan3.$member.interface=$interface"
	uci -q set "mwan3.$member.metric=$metric"
	uci -q set "mwan3.$member.weight=$weight"
}

HAS_WAN_SFP=0
HAS_WAN=0
network_exists wan_sfp && HAS_WAN_SFP=1
network_exists wan && HAS_WAN=1

# Cellular interfaces belong in the existing WAN firewall zone. Wired
# interfaces retain the zones selected by the board defaults/operator.
wan_zone="$(uci -q show firewall | sed -nE 's/^firewall\.(@zone\[[0-9]+\])=zone$/\1/p' | while read -r section; do
	[ "$(uci -q get "firewall.$section.name" 2>/dev/null || true)" = 'wan' ] && {
		echo "$section"
		break
	}
done)"
if [ -n "${wan_zone:-}" ]; then
	for interface in 4_1 2_1; do
		case " $(uci -q get "firewall.$wan_zone.network" 2>/dev/null || true) " in
			*" $interface "*) ;;
			*) uci -q add_list "firewall.$wan_zone.network=$interface" ;;
		esac
	done
	uci -q commit firewall
fi

if [ "$HAS_WAN_SFP" = '1' ]; then
	configure_tracking wan_sfp 1.1.1.1 8.8.8.8
	configure_member balanced_wan_sfp wan_sfp 1 3
	configure_member failover_wan_sfp wan_sfp 1 1
fi
if [ "$HAS_WAN" = '1' ]; then
	configure_tracking wan 1.1.1.1 8.8.8.8
	configure_member balanced_wan wan 1 3
	configure_member failover_wan wan 2 1
fi

configure_tracking 4_1 1.1.1.1 8.8.8.8
configure_tracking 2_1 1.0.0.1 9.9.9.9
configure_member balanced_4_1 4_1 1 1
configure_member balanced_2_1 2_1 1 1
configure_member failover_4_1 4_1 3 1
configure_member failover_2_1 2_1 4 1

# Remove names from the earlier defaults so they cannot be reused with stale
# same-tier metrics after an attended upgrade.
for old_member in m4_1_m1_w1 m2_1_m1_w1 m2_1_m2_w1 mwan_m1_w3; do
	uci -q delete "mwan3.$old_member" 2>/dev/null || true
done

uci -q set mwan3.balanced='policy'
uci -q del mwan3.balanced.use_member 2>/dev/null || true
[ "$HAS_WAN_SFP" = '1' ] && uci -q add_list mwan3.balanced.use_member='balanced_wan_sfp'
[ "$HAS_WAN" = '1' ] && uci -q add_list mwan3.balanced.use_member='balanced_wan'
uci -q add_list mwan3.balanced.use_member='balanced_4_1'
uci -q add_list mwan3.balanced.use_member='balanced_2_1'
uci -q set mwan3.balanced.last_resort='unreachable'

# Strict default order: SFP WAN, copper WAN, modem 1, then modem 2. Missing
# wired interfaces are omitted while the remaining order stays intact.
uci -q set mwan3.failover='policy'
uci -q del mwan3.failover.use_member 2>/dev/null || true
[ "$HAS_WAN_SFP" = '1' ] && uci -q add_list mwan3.failover.use_member='failover_wan_sfp'
[ "$HAS_WAN" = '1' ] && uci -q add_list mwan3.failover.use_member='failover_wan'
uci -q add_list mwan3.failover.use_member='failover_4_1'
uci -q add_list mwan3.failover.use_member='failover_2_1'
uci -q set mwan3.failover.last_resort='unreachable'

# mwan3 evaluates rules in config order. Remove the stock HTTPS/balanced and
# stock catch-all rules, then put the narrow speed-test rules before our only
# IPv4 catch-all rule. mwan3 requires an exact single protocol whenever a
# destination port is set, so TCP and UDP need separate rules.
for old_rule in https default_rule_v4 default_rule_v6 speedtest_rule speedtest_tcp speedtest_udp default_rule; do
	uci -q delete "mwan3.$old_rule" 2>/dev/null || true
done
for protocol in tcp udp; do
	rule="speedtest_$protocol"
	uci -q set "mwan3.$rule=rule"
	uci -q set "mwan3.$rule.dest_port=8080,8443"
	uci -q set "mwan3.$rule.proto=$protocol"
	uci -q set "mwan3.$rule.sticky=0"
	uci -q set "mwan3.$rule.use_policy=balanced"
	uci -q set "mwan3.$rule.family=ipv4"
done

uci -q set mwan3.default_rule='rule'
uci -q set mwan3.default_rule.dest_ip='0.0.0.0/0'
uci -q set mwan3.default_rule.use_policy='failover'
uci -q set mwan3.default_rule.family='ipv4'
uci -q set mwan3.default_rule.proto='all'

uci -q set mwan3.globals='globals'
uci -q set mwan3.globals.enabled='1'
uci -q set mwan3.globals.mmx_mask='0x3F00'
uci -q commit mwan3

exit 0
