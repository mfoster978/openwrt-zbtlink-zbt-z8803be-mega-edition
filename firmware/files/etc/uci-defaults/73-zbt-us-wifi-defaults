#!/bin/sh
# Mega Edition US radio defaults.
#
# Do not write a numeric txpower for 2.4/5 GHz: mt7996 already selects the
# lower of the regulatory limit and the calibrated EEPROM target. A fixed
# value can only reduce that safety protection or misrepresent antenna EIRP.
# 6 GHz is advertised as a US very-low-power device; the matching regulatory
# database patch caps the complete 6 GHz band at 14 dBm EIRP.

. /lib/functions.sh

case "$(board_name)" in
	zbtlink,zbt-z8803be|zbtlink,zbt-z8803be,mt7988a-nand) ;;
	*) exit 0 ;;
esac

# The pinned vendor script runs immediately before this one and creates the
# three radios on a clean install. Retain the same fallback for unusual
# first-boot ordering and settings-preserving upgrades.
[ -s /etc/config/wireless ] || /sbin/wifi config >/dev/null 2>&1
[ -s /etc/config/wireless ] || /sbin/wifi detect > /etc/config/wireless 2>/dev/null
[ -s /etc/config/wireless ] || exit 0

changed=0
for radio in $(uci -q show wireless | sed -nE 's/^wireless\.([^.]+)=wifi-device$/\1/p'); do
	band="$(uci -q get "wireless.${radio}.band")"
	case "$band" in
		2g|5g|6g) ;;
		*) continue ;;
	esac

	uci -q set "wireless.${radio}.country=US"
	# hostapd parses country3 as hexadecimal. 20 therefore emits the neutral
	# 0x20 country-string octet; the old value 32 incorrectly emitted 0x32.
	# VLP is not restricted to the indoor-only environment used by US LPI APs.
	uci -q set "wireless.${radio}.country3=20"
	uci -q delete "wireless.${radio}.txpower" 2>/dev/null
	uci -q delete "wireless.${radio}.min_tx_power" 2>/dev/null

	if [ "$band" = "6g" ]; then
		# hostapd 6 GHz regulatory power type 2 = very low power (VLP).
		uci -q set "wireless.${radio}.reg_power_type=2"
	else
		uci -q delete "wireless.${radio}.reg_power_type" 2>/dev/null
		uci -q delete "wireless.${radio}.he_6ghz_reg_pwr_type" 2>/dev/null
	fi
	changed=1
done

[ "$changed" -eq 0 ] && exit 0
uci -q commit wireless
logger -t zbt-wifi 'applied US defaults; 2.4/5 GHz auto power and 6 GHz 14 dBm VLP ceiling'

# The vendor defaults may already queue a reload on a clean install. Defer our
# reload long enough for that one to finish and coalesce it with the MLO repair
# below, avoiding concurrent hostapd teardown/creation and false disabled radios.
/usr/sbin/zbt-wifi-reload-deferred 10

exit 0
