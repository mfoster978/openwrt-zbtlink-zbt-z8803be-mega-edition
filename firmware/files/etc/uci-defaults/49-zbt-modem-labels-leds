#!/bin/sh
# Idempotent upgrade migration; no modem/network reload or power toggles.
for section in 4_1 2_1; do
	/usr/sbin/zbt-qmodem-profile "$section"
done

# Populate LuCI's stock System -> LED Configuration with the four physical
# Ethernet jack indicators. MediaTek phylib exposes these names from the DTS;
# the netdev trigger is hardware-offloaded by the PHY, keeping link solid and
# blinking for receive/transmit traffic without a polling process.
ensure_ethernet_led() {
	local name="$1" sysfs="$2" device="$3" section
	for section in $(uci -q show system 2>/dev/null | sed -n 's/^system\.\([^.=]*\)=led$/\1/p'); do
		[ "$(uci -q get "system.$section.sysfs" 2>/dev/null)" = "$sysfs" ] && return 0
	done
	section=$(uci add system led) || return 1
	uci set "system.$section.name=$name"
	uci set "system.$section.sysfs=$sysfs"
	uci set "system.$section.trigger=netdev"
	uci set "system.$section.dev=$device"
	uci set "system.$section.mode=link tx rx"
}

ensure_automatic_led() {
	local name="$1" sysfs="$2" section
	for section in $(uci -q show system 2>/dev/null | sed -n 's/^system\.\([^.=]*\)=led$/\1/p'); do
		[ "$(uci -q get "system.$section.sysfs" 2>/dev/null)" = "$sysfs" ] && return 0
	done
	section=$(uci add system led) || return 1
	uci set "system.$section.name=$name"
	uci set "system.$section.sysfs=$sysfs"
	uci set "system.$section.trigger=none"
	uci set "system.$section.zbt_automatic=1"
}

case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	zbtlink,zbt-z8803be|zbtlink,zbt-z8803be,mt7988a-nand)
		ensure_ethernet_led 'LAN 1 orange: link and activity' 'mt7530-0:00:green:lan' lan0
		ensure_ethernet_led 'LAN 2 orange: link and activity' 'mt7530-0:02:green:lan' lan1
		ensure_ethernet_led 'LAN 3 orange: link and activity' 'mt7530-0:03:green:lan' lan2
		ensure_ethernet_led 'WAN orange: link and activity' 'mdio-bus:0f:amber:wan' eth1
		ensure_automatic_led '5G1 green (automatic)' 'blue:mobile-1'
		ensure_automatic_led '5G2 green (automatic)' 'blue:mobile-2'
		ensure_automatic_led 'SYS red (automatic)' 'red:status'
		ensure_automatic_led 'SYS green (automatic)' 'green:wan'
		ensure_automatic_led 'SYS blue (automatic)' 'blue:power'
		uci commit system
		;;
esac
# Remove obsolete boot links, then enable S97. "disable" only edits rc.d
# symlinks; it does not stop the running LED service or touch either modem.
/etc/init.d/zbt-modem-leds disable
/etc/init.d/zbt-modem-leds enable
exit 0
