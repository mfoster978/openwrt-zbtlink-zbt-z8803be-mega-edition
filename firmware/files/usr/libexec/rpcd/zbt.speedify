#!/bin/sh
# Read-only daemon status for support diagnostics. Speedify's own UI handles
# account activation; Mega does not generate or filter sign-in links.
case "$1:$2" in
	list:*) echo '{"status":{}}'; exit 0 ;;
	call:status) read -r input ;;
	*) exit 1 ;;
esac
cli=/usr/share/speedify/speedify_cli
if [ ! -x "$cli" ]; then
	echo '{"ok":false,"message":"Speedify is not installed yet. Its installer needs working Internet access."}'
	exit 0
fi
case "$2" in
	status)
		if ! response=$(timeout 8 "$cli" show user 2>/dev/null); then
			echo '{"ok":false,"message":"The Speedify service did not answer. Check its service and Internet connection."}'
			exit 0
		fi
		printf '%s' "$response" | jq -ce '
			if type != "object" or (.isAutoAccount|type) != "boolean" then error("invalid user reply") else
			{ok:true, signed_in:(.isAutoAccount==false and (.email|type)=="string" and (.email|length)>0),
			email:(if (.email|type)=="string" then .email else "" end)} end' 2>/dev/null ||
			echo '{"ok":false,"message":"Speedify returned an unreadable account status; sign-in has not been confirmed."}'
		;;
esac
