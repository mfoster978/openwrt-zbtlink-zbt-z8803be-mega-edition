#!/bin/sh
# Re-evaluate policies without restarting interfaces, rewriting flash, or
# erasing the user's uncommitted UCI changes.
. /lib/functions.sh
. /lib/functions/network.sh
. /lib/mwan3/mwan3.sh
initscript=/etc/init.d/mwan3
. /lib/functions/procd.sh
/etc/init.d/mwan3 running >/dev/null 2>&1 || exit 0
procd_lock
mwan3_init
mwan3_set_policies_iptables
