#!/bin/sh
set -eu

TAG="speedify-installer"
STATE_DIR="/tmp/speedify-installer"
DONE_FILE="/etc/speedify.installed"
SLEEP_SECONDS="${SPEEDIFY_INSTALL_RETRY_SECONDS:-180}"

log() { logger -t "$TAG" "$*"; }

already_installed() {
	command -v speedify_cli >/dev/null 2>&1 || [ -x /usr/share/speedify/speedify_cli ]
}
verify_luci() {
	[ -x /www/cgi-bin/luci ] || return 0
	wget -q -T 8 -O /dev/null http://127.0.0.1/cgi-bin/luci >/tmp/speedify-luci-check.log 2>&1
}

has_working_wan() {
	ping -c1 -W2 1.1.1.1 >/dev/null 2>&1
}

has_working_dns() {
	nslookup get.speedify.com >/dev/null 2>&1
}

wait_for_connectivity() {
	while :; do
		if has_working_wan && has_working_dns; then
			return 0
		fi
		log "waiting for WAN and DNS before install attempt"
		sleep 20
	done
}

download_apk_bundle() {
	local arch
	arch="$(cat /etc/apk/arch 2>/dev/null || true)"
	[ -n "${arch:-}" ] || return 1
	wget -q "https://downloads.speedify.com/speedify_${arch}.apk" -O "$STATE_DIR/speedify.apk" || return 1
	wget -q "https://downloads.speedify.com/luci-app-speedify_noarch.apk" -O "$STATE_DIR/luci-app-speedify_noarch.apk" || return 1
	return 0
}

install_via_apk() {
	apk update >/tmp/speedify-apk-update.log 2>&1 || true
	download_apk_bundle || return 1
	apk add --allow-untrusted "$STATE_DIR/speedify.apk" "$STATE_DIR/luci-app-speedify_noarch.apk" >/tmp/speedify-apk-install.log 2>&1 || return 1
	return 0
}

install_via_opkg() {
	local arch
	opkg update >/tmp/speedify-opkg-update.log 2>&1 || true
	arch="$(opkg print-architecture | awk 'END{print $2}')"
	[ -n "${arch:-}" ] || return 1
	wget -q "https://downloads.speedify.com/speedify_${arch}.ipk" -O "$STATE_DIR/speedify.ipk" || return 1
	wget -q "https://downloads.speedify.com/luci-app-speedify_all.ipk" -O "$STATE_DIR/luci-app-speedify_all.ipk" || return 1
	opkg install "$STATE_DIR/speedify.ipk" "$STATE_DIR/luci-app-speedify_all.ipk" >/tmp/speedify-opkg-install.log 2>&1 || return 1
	return 0
}

install_via_official_script() {
	wget -q https://get.speedify.com -O- | sh >/tmp/speedify-bootstrap.log 2>&1
}

mkdir -p "$STATE_DIR"

if already_installed; then
	log "already installed"
	verify_luci && log "luci health probe passed" || log "luci health probe failed; see /tmp/speedify-luci-check.log"
	touch "$DONE_FILE"
	exit 0
fi

while :; do
	wait_for_connectivity
	if command -v apk >/dev/null 2>&1 && install_via_apk && already_installed; then
		log "installed via apk allow-untrusted bundle"
		verify_luci && log "luci health probe passed" || log "luci health probe failed; see /tmp/speedify-luci-check.log"
		touch "$DONE_FILE"
		exit 0
	fi
	if command -v opkg >/dev/null 2>&1 && install_via_opkg && already_installed; then
		log "installed via opkg bundle"
		verify_luci && log "luci health probe passed" || log "luci health probe failed; see /tmp/speedify-luci-check.log"
		touch "$DONE_FILE"
		exit 0
	fi
	if install_via_official_script && already_installed; then
		log "installed via official script fallback"
		verify_luci && log "luci health probe passed" || log "luci health probe failed; see /tmp/speedify-luci-check.log"
		touch "$DONE_FILE"
		exit 0
	fi
	log "install attempt failed; retrying in ${SLEEP_SECONDS}s"
	sleep "$SLEEP_SECONDS"
done
