#!/bin/sh
set -eu

TAG="speedify-installer"
STATE_DIR="/tmp/speedify-installer"
DONE_FILE="/etc/speedify.installed"
SLEEP_SECONDS="${SPEEDIFY_INSTALL_RETRY_SECONDS:-180}"
REQUIRE_CHECKSUM="${SPEEDIFY_REQUIRE_CHECKSUM:-1}"
ALLOW_OFFICIAL_SCRIPT_FALLBACK="${SPEEDIFY_ALLOW_OFFICIAL_SCRIPT_FALLBACK:-0}"
CORE_DEPS="${SPEEDIFY_CORE_DEPS:-ca-bundle ca-certificates curl jq kmod-tun ip-full iptables-nft}"

log() { logger -t "$TAG" "$*"; }

already_installed() {
	command -v speedify_cli >/dev/null 2>&1 || [ -x /usr/share/speedify/speedify_cli ]
}

install_core_deps_apk() {
	local pkg
	apk update >/tmp/speedify-apk-update.log 2>&1 || true
	for pkg in $CORE_DEPS; do
		apk info -e "$pkg" >/dev/null 2>&1 || apk add "$pkg" >/tmp/speedify-apk-deps.log 2>&1 || return 1
	done
	return 0
}

install_core_deps_opkg() {
	local pkg
	opkg update >/tmp/speedify-opkg-update.log 2>&1 || true
	for pkg in $CORE_DEPS; do
		opkg status "$pkg" 2>/dev/null | grep -q '^Status:.* installed' || opkg install "$pkg" >/tmp/speedify-opkg-deps.log 2>&1 || return 1
	done
	return 0
}

verify_checksum_from_sidecar() {
	local file url sidecar expected actual
	file="$1"
	url="$2"
	sidecar="$STATE_DIR/$(basename "$file").sha256"
	wget -q "${url}.sha256" -O "$sidecar" || return 1
	expected="$(awk '{print $1}' "$sidecar" | head -n1)"
	[ -n "${expected:-}" ] || return 1
	actual="$(sha256sum "$file" | awk '{print $1}')"
	[ "$expected" = "$actual" ]
}

verify_or_fail() {
	local file url
	file="$1"
	url="$2"
	if [ "$REQUIRE_CHECKSUM" != "1" ]; then
		return 0
	fi
	verify_checksum_from_sidecar "$file" "$url"
}
verify_luci() {
	[ -x /www/cgi-bin/luci ] || return 0
	wget -q -T 8 -O /dev/null http://127.0.0.1/cgi-bin/luci >/tmp/speedify-luci-check.log 2>&1
}

has_working_wan() {
	ping -c1 -W2 1.1.1.1 >/dev/null 2>&1
}

has_working_dns() {
	nslookup get.speedify.com >/dev/null 2>&1
}

wait_for_connectivity() {
	while :; do
		if has_working_wan && has_working_dns; then
			return 0
		fi
		log "waiting for WAN and DNS before install attempt"
		sleep 20
	done
}

download_apk_bundle() {
	local arch speedify_url luci_url
	arch="$(cat /etc/apk/arch 2>/dev/null || true)"
	[ -n "${arch:-}" ] || return 1
	speedify_url="https://downloads.speedify.com/speedify_${arch}.apk"
	luci_url="https://downloads.speedify.com/luci-app-speedify_noarch.apk"
	wget -q "$speedify_url" -O "$STATE_DIR/speedify.apk" || return 1
	wget -q "$luci_url" -O "$STATE_DIR/luci-app-speedify_noarch.apk" || return 1
	verify_or_fail "$STATE_DIR/speedify.apk" "$speedify_url" || return 1
	verify_or_fail "$STATE_DIR/luci-app-speedify_noarch.apk" "$luci_url" || return 1
	return 0
}

install_via_apk() {
	install_core_deps_apk || return 1
	download_apk_bundle || return 1
	apk add --allow-untrusted "$STATE_DIR/speedify.apk" "$STATE_DIR/luci-app-speedify_noarch.apk" >/tmp/speedify-apk-install.log 2>&1 || return 1
	return 0
}

install_via_opkg() {
	local arch speedify_url luci_url
	install_core_deps_opkg || return 1
	arch="$(opkg print-architecture | awk 'END{print $2}')"
	[ -n "${arch:-}" ] || return 1
	speedify_url="https://downloads.speedify.com/speedify_${arch}.ipk"
	luci_url="https://downloads.speedify.com/luci-app-speedify_all.ipk"
	wget -q "$speedify_url" -O "$STATE_DIR/speedify.ipk" || return 1
	wget -q "$luci_url" -O "$STATE_DIR/luci-app-speedify_all.ipk" || return 1
	verify_or_fail "$STATE_DIR/speedify.ipk" "$speedify_url" || return 1
	verify_or_fail "$STATE_DIR/luci-app-speedify_all.ipk" "$luci_url" || return 1
	opkg install "$STATE_DIR/speedify.ipk" "$STATE_DIR/luci-app-speedify_all.ipk" >/tmp/speedify-opkg-install.log 2>&1 || return 1
	return 0
}

install_via_official_script() {
	wget -q https://get.speedify.com -O- | sh >/tmp/speedify-bootstrap.log 2>&1
}

mkdir -p "$STATE_DIR"

if already_installed; then
	log "already installed"
	verify_luci && log "luci health probe passed" || log "luci health probe failed; see /tmp/speedify-luci-check.log"
	touch "$DONE_FILE"
	exit 0
fi

while :; do
	wait_for_connectivity
	if command -v apk >/dev/null 2>&1 && install_via_apk && already_installed; then
		log "installed via apk allow-untrusted bundle"
		verify_luci && log "luci health probe passed" || log "luci health probe failed; see /tmp/speedify-luci-check.log"
		touch "$DONE_FILE"
		exit 0
	fi
	if command -v opkg >/dev/null 2>&1 && install_via_opkg && already_installed; then
		log "installed via opkg bundle"
		verify_luci && log "luci health probe passed" || log "luci health probe failed; see /tmp/speedify-luci-check.log"
		touch "$DONE_FILE"
		exit 0
	fi
	if [ "$ALLOW_OFFICIAL_SCRIPT_FALLBACK" = "1" ] && install_via_official_script && already_installed; then
		log "installed via official script fallback"
		verify_luci && log "luci health probe passed" || log "luci health probe failed; see /tmp/speedify-luci-check.log"
		touch "$DONE_FILE"
		exit 0
	fi
	log "install attempt failed; retrying in ${SLEEP_SECONDS}s"
	sleep "$SLEEP_SECONDS"
done
