#!/bin/sh
set -u

TAG='speedify-installer'
STATE_DIR='/tmp/speedify-installer'
LOCK_DIR='/var/lock/speedify-installer.lock'
DONE_FILE='/etc/speedify.installed'
RETRY_SECONDS="${SPEEDIFY_INSTALL_RETRY_SECONDS:-180}"
CONNECTIVITY_RETRY_SECONDS='30'
EXPECTED_ARCH='aarch64_cortex-a53'
SPEEDIFY_VERSION='17.1.0-r12947'
SPEEDIFY_URL='https://downloads.speedify.com/speedify_aarch64_cortex-a53.apk'
SPEEDIFY_SHA256='876ec301cee1a2bb9136ccef6c050762456525b15ac645581b44f0c16630947d'
LUCI_URL='https://downloads.speedify.com/luci-app-speedify_noarch.apk'
LUCI_SHA256='efaa6f7da76e4ad5c6bb407aa503886e6af828100a1263698ec26b4335e14167'
CORE_DEPS='busybox ca-bundle curl kmod-tun libstdcpp6 iptables-nft libkeyutils1 libatomic1 kmod-nft-tproxy iptables-mod-tproxy kmod-tcp-bbr iptables-mod-extra iptables-mod-conntrack-extra'
UI_DEPS='luci-nginx python3-light'
LUCI_WRAPPER='/usr/share/zbt/speedify-luci-wrapper.js'
LUCI_WRAPPER_TARGET='/www/luci-static/resources/view/speedify/speedify.js'
INSTALL_LUCI="$(uci -q get speedify_bootstrap.main.install_luci 2>/dev/null || echo 1)"

log() {
	logger -t "$TAG" "$*"
}

package_installed() {
	apk info -e "$1" >/dev/null 2>&1
}

packages_complete() {
	package_installed speedify || return 1
	command -v speedify_cli >/dev/null 2>&1 || [ -x /usr/share/speedify/speedify_cli ] || return 1
	if [ "$INSTALL_LUCI" = '1' ]; then
		package_installed luci-app-speedify || return 1
	fi
}

service_running() {
	[ -x "/etc/init.d/$1" ] && "/etc/init.d/$1" status >/dev/null 2>&1
}

install_luci_wrapper() {
	[ "$INSTALL_LUCI" = '1' ] || return 0
	[ -s "$LUCI_WRAPPER" ] || {
		log 'reviewed Speedify LuCI wrapper is missing'
		return 1
	}
	mkdir -p "${LUCI_WRAPPER_TARGET%/*}" || return 1
	if ! cmp -s "$LUCI_WRAPPER" "$LUCI_WRAPPER_TARGET"; then
		cp "$LUCI_WRAPPER" "$LUCI_WRAPPER_TARGET" || return 1
		rm -f /tmp/luci-indexcache /tmp/luci-indexcache.json
		log 'installed Speedify login-return refresh wrapper'
	fi
}

sync_nginx_luci_frontend() {
	# The Speedify APK installs nginx location snippets. Keep port 80 on the
	# same _lan server that includes those snippets; a preserved redirect or
	# missing include otherwise makes LuCI work while Speedify returns 404.
	uci -q delete nginx._redirect2ssl 2>/dev/null || true
	uci -q set nginx.global='main' || return 1
	uci -q set nginx.global.uci_enable='true' || return 1
	uci -q set nginx._lan='server' || return 1
	uci -q set nginx._lan.server_name='_lan' || return 1
	uci -q del_list nginx._lan.listen='80' 2>/dev/null || true
	uci -q del_list nginx._lan.listen='80 default_server' 2>/dev/null || true
	uci -q del_list nginx._lan.listen='[::]:80' 2>/dev/null || true
	uci -q del_list nginx._lan.listen='[::]:80 default_server' 2>/dev/null || true
	uci -q add_list nginx._lan.listen='80 default_server' || return 1
	uci -q add_list nginx._lan.listen='[::]:80 default_server' || return 1
	uci -q del_list nginx._lan.include='conf.d/*.locations' 2>/dev/null || true
	uci -q add_list nginx._lan.include='conf.d/*.locations' || return 1
	uci -q commit nginx || return 1
}

luci_healthy() {
	[ "$INSTALL_LUCI" = '1' ] || return 0
	service_running uwsgi || return 1
	[ -S /var/run/luci-webui.socket ] || return 1
	service_running nginx || return 1
	service_running sfy-ws-auth || return 1
	nginx -t >/tmp/speedify-nginx-check.log 2>&1 || return 1
	# Verify both real frontends. -k applies ONLY to this loopback self-signed
	# certificate, never to APK downloads.
	http_status="$(curl -sS --max-time 10 -o /dev/null -w '%{http_code}' http://127.0.0.1/cgi-bin/luci/ 2>/dev/null || true)"
	case "$http_status" in
		2??|3??) ;;
		*) return 1 ;;
	esac
	http_status="$(curl -ksS --max-time 10 -o /dev/null -w '%{http_code}' https://127.0.0.1/cgi-bin/luci/ 2>/dev/null || true)"
	case "$http_status" in
		2??|3??) ;;
		*) return 1 ;;
	esac
	# Speedify requires HTTPS. HTTP must redirect only this application while
	# the protected HTTPS entry point challenges an unauthenticated request.
	# 404 means the nginx locations were not included; 502 means proxy down.
	http_status="$(curl -sS --max-time 10 -o /dev/null -w '%{http_code}' http://127.0.0.1/luci-app-speedify/view/index.html 2>/dev/null || true)"
	[ "$http_status" = 307 ] || return 1
	http_status="$(curl -ksS --max-time 10 -o /dev/null -w '%{http_code}' https://127.0.0.1/luci-app-speedify/view/index.html 2>/dev/null || true)"
	[ "$http_status" = 401 ]
}

runtime_healthy() {
	service_running speedify && luci_healthy
}

wait_for_runtime() {
	attempt='0'
	while [ "$attempt" -lt 15 ]; do
		runtime_healthy && return 0
		attempt=$((attempt + 1))
		sleep 2
	done
	return 1
}

activate_services() {
	/etc/init.d/speedify enable >/dev/null 2>&1 || return 1
	service_running speedify || /etc/init.d/speedify start >/tmp/speedify-service.log 2>&1
	if [ "$INSTALL_LUCI" = '1' ]; then
		install_luci_wrapper || return 1
		sync_nginx_luci_frontend || return 1
		# Keep LuCI itself healthy independently of the optional vendor UI.
		# This also repairs a preserved, incompatible uWSGI configuration once.
		/usr/sbin/zbt-luci-backend-check >/tmp/speedify-luci-backend.log 2>&1 || return 1
		# uhttpd cannot serve the vendor's authenticated nginx alias/proxy UI.
		# Keep the existing nginx LuCI frontend even if the VPN daemon fails.
		if [ -f /usr/share/luci-app-speedify/luci-app-speedify.locations ]; then
			if [ "$(readlink /etc/nginx/conf.d/luci-app-speedify.locations 2>/dev/null)" != /usr/share/luci-app-speedify/luci-app-speedify.locations ]; then
				rm -f /etc/nginx/conf.d/luci-app-speedify.locations
				ln -s /usr/share/luci-app-speedify/luci-app-speedify.locations /etc/nginx/conf.d/luci-app-speedify.locations || return 1
			fi
			# Old preserved CGI routing predates the authenticated vendor proxy.
			rm -f /etc/nginx/conf.d/luci-cgi-speedify.locations
		fi
		/etc/init.d/sfy-ws-auth enable >/dev/null 2>&1 || return 1
		service_running sfy-ws-auth || /etc/init.d/sfy-ws-auth start >/tmp/speedify-ws-auth.log 2>&1
		nginx -t >/tmp/speedify-nginx-check.log 2>&1 || return 1
		/etc/init.d/uhttpd stop >/dev/null 2>&1 || true
		/etc/init.d/uhttpd disable >/dev/null 2>&1 || true
		/etc/init.d/nginx enable >/dev/null 2>&1 || return 1
		/etc/init.d/nginx reload >/tmp/speedify-nginx.log 2>&1 || /etc/init.d/nginx start >>/tmp/speedify-nginx.log 2>&1 || return 1
	fi
}

finalize_luci_webserver() {
	[ "$INSTALL_LUCI" = '1' ] || return 0
	uci -q delete uhttpd.main.listen_http 2>/dev/null || true
	uci -q delete uhttpd.main.listen_https 2>/dev/null || true
	uci -q commit uhttpd 2>/dev/null || true
	/etc/init.d/uhttpd disable >/dev/null 2>&1 || true
}

finish_if_ready() {
	packages_complete || return 1
	# Expose the installed UI for diagnosis even while the VPN daemon is
	# unhealthy. Do not make menu visibility depend on a successful VPN start.
	if [ "$INSTALL_LUCI" = 1 ] && [ ! -f "$STATE_DIR/menu-refreshed" ]; then
		rm -f /tmp/luci-indexcache /tmp/luci-indexcache.json
		/etc/init.d/rpcd reload >/dev/null 2>&1 || true
		touch "$STATE_DIR/menu-refreshed"
	fi
	if ! activate_services || ! wait_for_runtime; then
		log "health pending: speedify=$(service_running speedify && echo up || echo down) nginx=$(service_running nginx && echo up || echo down) sfy-ws-auth=$(service_running sfy-ws-auth && echo up || echo down); preserving nginx and installed packages"
		return 1
	fi
	finalize_luci_webserver
	touch "$DONE_FILE"
	/etc/init.d/speedify-installer disable >/dev/null 2>&1 || true
	log "Speedify ${SPEEDIFY_VERSION} installation and health checks completed"
	return 0
}

baked_dependencies_present() {
	missing=''
	deps="$CORE_DEPS"
	[ "$INSTALL_LUCI" = '1' ] && deps="$deps $UI_DEPS"
	for package in $deps; do
		package_installed "$package" || missing="$missing $package"
	done
	if [ -n "$missing" ]; then
		log "required baked packages are missing:$missing"
		return 1
	fi
	return 0
}

download_checked() {
	url="$1"
	destination="$2"
	expected="$3"
	partial="${destination}.part"
	rm -f "$partial"
	curl -fL --connect-timeout 20 --max-time 600 --retry 3 --retry-delay 5 \
		-o "$partial" "$url" >/tmp/speedify-download.log 2>&1 || {
		rm -f "$partial"
		return 1
	}
	actual="$(sha256sum "$partial" | awk '{print $1}')"
	if [ "$actual" != "$expected" ]; then
		log "refusing $(basename "$url"): expected SHA256 $expected, got $actual"
		rm -f "$partial"
		return 1
	fi
	mv -f "$partial" "$destination"
}

download_bundle() {
	download_checked "$SPEEDIFY_URL" "$STATE_DIR/speedify.apk" "$SPEEDIFY_SHA256" || return 1
	if [ "$INSTALL_LUCI" = '1' ]; then
		download_checked "$LUCI_URL" "$STATE_DIR/luci-app-speedify.apk" "$LUCI_SHA256" || return 1
	fi
}

install_bundle() {
	set -- "$STATE_DIR/speedify.apk"
	[ "$INSTALL_LUCI" = '1' ] && set -- "$@" "$STATE_DIR/luci-app-speedify.apk"
	# Dependencies must come from the matching firmware build. Never fetch a
	# kernel module from a live repository during first-boot installation.
	apk add --allow-untrusted --no-network "$@" >/tmp/speedify-apk-install.log 2>&1
}

has_download_connectivity() {
	curl -fsSI --connect-timeout 10 --max-time 20 "$SPEEDIFY_URL" >/dev/null 2>&1
}

[ "$(cat /etc/apk/arch 2>/dev/null || true)" = "$EXPECTED_ARCH" ] || {
	log "unsupported APK architecture; expected $EXPECTED_ARCH"
	exit 1
}

mkdir -p "$STATE_DIR" /var/lock
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
	lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
	case "$lock_pid" in
		''|*[!0-9]*) lock_pid='' ;;
	esac
	if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
		log 'another installer instance is already running'
		exit 0
	fi
	rm -f "$LOCK_DIR/pid"
	rmdir "$LOCK_DIR" 2>/dev/null || {
		log 'installer lock could not be recovered'
		exit 1
	}
	mkdir "$LOCK_DIR" || exit 1
fi
printf '%s\n' "$$" > "$LOCK_DIR/pid"
cleanup() {
	rm -f "$STATE_DIR"/*.part
	rm -f "$LOCK_DIR/pid"
	rmdir "$LOCK_DIR" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM

if finish_if_ready; then
	exit 0
fi
rm -f "$DONE_FILE"

while :; do
	# A runtime failure is not an installation failure. Reinstalling here
	# reran the vendor's network/firewall setup every three minutes.
	if packages_complete; then
		finish_if_ready && exit 0
		sleep "$RETRY_SECONDS"
		continue
	fi
	if ! baked_dependencies_present; then
		sleep "$RETRY_SECONDS"
		continue
	fi
	if ! has_download_connectivity; then
		log 'waiting for HTTPS connectivity before installing Speedify'
		sleep "$CONNECTIVITY_RETRY_SECONDS"
		continue
	fi
	if download_bundle && install_bundle && finish_if_ready; then
		exit 0
	fi
	log "installation failed; retrying in ${RETRY_SECONDS}s"
	sleep "$RETRY_SECONDS"
done
