#!/bin/sh
. /usr/lib/zbt/dual-modem.sh
zbt_slot "$1" || exit 0
[ "$(uci -q get "qmodem.$1")" = modem-device ] || exit 0
# An alias is also QModem's netifd interface name. Keep one identity per slot.
changed=0
if [ "$(uci -q get "qmodem.$1.alias")" != "$1" ]; then
	uci set "qmodem.$1.alias=$1"
	changed=1
fi
metric=200; [ "$1" = 2_1 ] && metric=210
for setting in "metric=$metric" pdp_type=ipv4v6 auth=none do_not_add_dns=1 donot_nat=1 monitor_enabled=0 enable_dial=1; do
	key=${setting%%=*}
	if ! uci -q get "qmodem.$1.$key" >/dev/null; then
		uci set "qmodem.$1.$setting"
		changed=1
	fi
done
# Blank/auto APN is intentionally not replaced with a T-Mobile/AT&T value.
[ "$changed" = 0 ] || uci commit qmodem
