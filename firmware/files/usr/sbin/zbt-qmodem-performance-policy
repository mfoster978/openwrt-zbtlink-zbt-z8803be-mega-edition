#!/bin/sh
# Mega boot policy shares exactly the same verified transaction as the UI.
. /usr/share/qmodem/modem_util.sh
. /usr/lib/zbt/dual-modem.sh
. /usr/lib/zbt/qmodem-5g.sh

section_ready() {
	case "$1" in 4_1|2_1) ;; *) return 1 ;; esac
	[ "$(uci -q get "qmodem.$1")" = modem-device ] || return 1
	manufacturer=$(uci -q get "qmodem.$1.manufacturer")
	at_port=$(uci -q get "qmodem.$1.at_port")
	use_ubus_flag=''
	[ "$(uci -q get "qmodem.$1.use_ubus")" != 1 ] || use_ubus_flag=-u
	zbt_5g_vendor && [ -c "$at_port" ] && zbt_port_matches "$1" "$at_port"
}

apply_policy() {
	local section="$1" policy
	section_ready "$section" || return 1
	policy=$(uci -q get "qmodem.$section.zbt_5g_policy")
	[ -n "$policy" ] || policy=auto_preferred
	if zbt_5g_apply "$policy"; then
		logger -t zbt-5g-policy "$section policy $policy: $zbt_5g_message"
	else
		logger -t zbt-5g-policy "$section policy not applied: $zbt_5g_message"
		return 1
	fi
}

case "$1" in
	desired) zbt_5g_value "$3" ;;
	query) section_ready "$2" && zbt_5g_read nr5g_disable_mode && echo "$zbt_5g_read_value" ;;
	apply) apply_policy "$2" ;;
	*) exit 2 ;;
esac
