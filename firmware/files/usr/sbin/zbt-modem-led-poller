#!/bin/sh
. /usr/lib/zbt/modem-leds.sh

cycle() {
	local section key previous result owner expected=0 online=0 bytes=0 value status_state
	for section in 4_1 2_1; do
		zbt_led_detect "$section" || continue
		if [ "$ZBT_LED_POWER" = 1 ] || [ -d "${ZBT_SYSFS:-/sys}/bus/usb/devices/$ZBT_USB" ]; then
			expected=$((expected + 1))
			if [ "$ZBT_LED_STATE" = data ]; then
				online=$((online + 1))
				for value in rx_bytes tx_bytes; do
					value=$(cat "${ZBT_SYSFS:-/sys}/class/net/$ZBT_LED_DEVICE/statistics/$value" 2>/dev/null)
					case "$value" in ''|*[!0-9]*) value=0 ;; esac
					bytes=$((bytes + value))
				done
			fi
		fi
		result=ok
		if [ "$1" != status ]; then
			zbt_led_apply || result=write_failed
		fi
		owner=automatic
		zbt_led_user_managed && owner=user
		key="$ZBT_LED_STATE:${ZBT_LED_DEVICE:-absent}:$(zbt_led_trigger):$result:$owner"
		if [ "$1" = status ]; then
			printf 'modem=%s usb=%s power=%s device=%s state=%s led=%s owner=%s trigger=%s brightness=%s\n' \
				"$section" "$ZBT_USB" "$ZBT_LED_POWER" "${ZBT_LED_DEVICE:-absent}" "$ZBT_LED_STATE" \
				"$ZBT_LED" "$owner" "$(zbt_led_trigger)" "$(zbt_led_read brightness)"
		else
			eval "previous=\${last_$section:-}"
			[ "$key" = "$previous" ] || logger -t zbt-modem-leds "$section: $key (power=$ZBT_LED_POWER led=$ZBT_LED)"
			eval "last_$section=\$key"
		fi
	done
	if [ "$1" != status ]; then
		if ! ip -4 route show default 2>/dev/null | grep -q '^default'; then
			status_state=offline
		elif [ "$expected" -gt 0 ] && [ "$online" -lt "$expected" ]; then
			status_state=fault
		elif [ -n "${last_status_bytes:-}" ] && [ "$bytes" -ne "$last_status_bytes" ]; then
			status_state=traffic
		else
			status_state=connected
		fi
		zbt_status_apply "$status_state" || logger -t zbt-modem-leds "SYS LED update failed: $status_state"
		last_status_bytes=$bytes
	fi
}

case "${1:-daemon}" in
	status) cycle status ;; # Read-only: safe to include in support diagnostics.
	once) cycle once ;;
	daemon) while :; do cycle daemon; sleep 5; done ;;
	*) echo 'Usage: zbt-modem-led-poller [daemon|once|status]' >&2; exit 2 ;;
esac
