{
  "luci-app-modem-watchdog": {
    "description": "Grant access to modem watchdog UCI",
    "read": {
      "uci": [ "modem_watchdog", "qmodem", "network", "firewall", "mwan3" ]
    },
    "write": {
      "uci": [ "modem_watchdog", "qmodem", "network", "firewall", "mwan3" ],
      "file": {
        "/usr/sbin/zbt-mwan-preset priority": [ "exec" ],
        "/usr/sbin/zbt-mwan-preset failover": [ "exec" ]
      }
    }
  }
}
