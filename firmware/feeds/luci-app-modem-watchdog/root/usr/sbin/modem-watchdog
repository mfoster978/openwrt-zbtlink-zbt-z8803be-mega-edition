#!/bin/sh
# Optional connectivity recovery and fresh-sample-driven mwan3 preferences.
. /usr/lib/zbt/dual-modem.sh
. /usr/lib/zbt/speed-policy.sh
. /usr/lib/zbt/speed-lock.sh
RUNDIR=/tmp/modem-watchdog
umask 077
mkdir -p "$RUNDIR" /tmp/zbt-speedtest
get() { uci -q get "modem_watchdog.$1" 2>/dev/null || true; }
uint() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) [ "$1" -ge 1 ] && [ "$1" -le 86400 ] && echo "$1" || echo "$2" ;; esac; }
now() { cut -d. -f1 /proc/uptime; }
cleanup() {
	zbt_speed_unlock
	rm -f "$RUNDIR/4_1.metric" "$RUNDIR/2_1.metric"
	/usr/sbin/zbt-mwan-apply >/dev/null 2>&1 || true
}
trap 'cleanup; exit 0' INT TERM
check_modem() {
	local key="$1" section="$2" device sample value stamp last=0 speed='' bad=0 good=0 blocked=0 fails=0 last_action=0 action
	if ! device=$(zbt_netdev "$section") ||
	   [ "$(get "$key.enabled")" != 1 ] ||
	   [ "$(uci -q get "qmodem.$section.enable_dial")" != 1 ] ||
	   [ "$(uci -q get qmodem.main.enable_dial)" != 1 ]; then
		rm -f "$RUNDIR/$section.state"
		return 0
	fi
	if [ -f "$RUNDIR/$section.state" ]; then
		read -r last speed bad good blocked fails last_action < "$RUNDIR/$section.state"
		[ "$speed" != '-' ] || speed=''
	fi
	stamp=$(now)
	# Sharing the measurement lock prevents overlapping background/UI tests.
	if [ ! -d /tmp/zbt-speedtest/lock ]; then
		if ping -I "$device" -c 1 -W 2 "$target" >/dev/null 2>&1; then fails=0; else fails=$((fails + 1)); fi
	fi
	if [ "$sampling" = 1 ] && [ $((stamp - last)) -ge "$sample_interval" ]; then
		if zbt_speed_lock; then
			sample=$(/usr/sbin/zbt-speed-sample "$section" download)
			zbt_speed_unlock
			value=$(printf '%s' "$sample" | jq -er 'select(.ok == true) | .download_mbps | numbers')
			last=$(now)
			if [ -n "$value" ]; then
				speed="$value"
				zbt_speed_transition "$speed" "$minimum" "$speed_threshold"
			else
				# An HTTP/DNS/time/server failure is NOT a low-speed result.
				speed=''; bad=0; good=0; blocked=0
				logger -t modem-watchdog "$section: throughput sample unavailable; no speed-based action"
			fi
		fi
	fi
	stamp=$(now)
	# Do not make decisions using old measurements or a disabled sampler.
	if [ "$sampling" != 1 ] || [ $((stamp - last)) -gt $((sample_interval * 2)) ]; then
		blocked=0; speed=''
	fi
	# Slow throughput changes preference only. Never power-cycle a healthy
	# modem simply because a speed-test server is slow.
	if [ "$actions" = 1 ] && [ "$fails" -ge "$ping_threshold" ] && [ $((stamp - last_action)) -ge "$cooldown" ]; then
		action=$(get "$key.action")
		case "$action" in
			redial) /etc/init.d/qmodem_network redial "$section" ;;
			power_cycle)
				zbt_slot "$section"
				# Ignore editable GPIO strings: the section selects its own pin.
				/etc/init.d/qmodem_network hang "$section"
				if [ -w "/sys/class/gpio/$ZBT_POWER/value" ]; then
					printf 0 > "/sys/class/gpio/$ZBT_POWER/value"; sleep 3
					printf 1 > "/sys/class/gpio/$ZBT_POWER/value"
				fi ;;
			disconnect) /etc/init.d/qmodem_network hang "$section" ;;
		esac
		last_action=$(now); fails=0
		logger -t modem-watchdog "$section: requested $action after connectivity failures"
	fi
	printf '%s %s %s %s %s %s %s\n' "$last" "${speed:--}" "$bad" "$good" "$blocked" "$fails" "$last_action" > "$RUNDIR/$section.state"
}
write_preference() {
	local section="$1" metric="$2" previous
	previous=$(awk '{print $2}' "$RUNDIR/$section.metric" 2>/dev/null)
	printf '%s %s\n' "$(($(now) + 150))" "$metric" > "$RUNDIR/$section.metric.new"
	mv "$RUNDIR/$section.metric.new" "$RUNDIR/$section.metric"
	[ "$previous" = "$metric" ] || changed=1
}
while [ "$(get global.enabled)" = 1 ]; do
	interval=$(uint "$(get global.interval_seconds)" 30)
	[ "$interval" -ge 10 ] || interval=10
	[ "$interval" -le 60 ] || interval=60
	sampling=$(get global.speed_test)
	sample_interval=$(uint "$(get global.speed_test_cooldown_minutes)" 15)
	sample_interval=$((sample_interval * 60))
	minimum=$(get global.speed_test_min_mbps)
	case "$minimum" in ''|*[!0-9.]*|*.*.*|.) minimum=5 ;; esac
	speed_threshold=$(uint "$(get global.speed_fail_threshold)" 2)
	ping_threshold=$(uint "$(get global.ping_fail_threshold)" 4)
	cooldown=$(uint "$(get global.cooldown_seconds)" 180)
	actions=$(get global.actions_enabled)
	target=$(get global.ping_target); [ -n "$target" ] || target=1.1.1.1
	check_modem modem1 4_1
	check_modem modem2 2_1
	if [ "$(get global.failover)" = 1 ]; then
		m1=3; m2=4; s1=''; s2=''
		if [ -f "$RUNDIR/4_1.state" ]; then
			read -r ts s1 bad good blocked rest < "$RUNDIR/4_1.state"
			[ "$blocked" != 1 ] || m1=5
		fi
		if [ -f "$RUNDIR/2_1.state" ]; then
			read -r ts s2 bad good blocked rest < "$RUNDIR/2_1.state"
			[ "$blocked" != 1 ] || m2=5
		fi
		delta=$(get global.fastest_delta_mbps)
		case "$delta" in ''|*[!0-9.]*|*.*.*|.) delta=5 ;; esac
		if [ "$m1$m2" = 34 ] && [ "$(get global.prefer_fastest)" = 1 ] &&
		   [ -n "$s1" ] && [ "$s1" != '-' ] && [ -n "$s2" ] && [ "$s2" != '-' ]; then
			if awk -v a="$s1" -v b="$s2" -v d="$delta" 'BEGIN { exit !(b > a + d) }'; then preferred=2
			elif awk -v a="$s1" -v b="$s2" -v d="$delta" 'BEGIN { exit !(a > b + d) }'; then preferred=1; fi
			[ "${preferred:-1}" != 2 ] || { m1=4; m2=3; }
		fi
		changed=0
		write_preference 4_1 "$m1"
		write_preference 2_1 "$m2"
		[ "$changed" = 0 ] || /usr/sbin/zbt-mwan-apply
	else
		if [ -f "$RUNDIR/4_1.metric" ] || [ -f "$RUNDIR/2_1.metric" ]; then cleanup; fi
	fi
	sleep "$interval"
done
cleanup
