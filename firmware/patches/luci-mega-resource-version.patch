diff --git a/modules/luci-base/ucode/runtime.uc b/modules/luci-base/ucode/runtime.uc
--- a/modules/luci-base/ucode/runtime.uc
+++ b/modules/luci-base/ucode/runtime.uc
@@ -1,7 +1,7 @@
 // Copyright 2022 Jo-Philipp Wich <jo@mein.io>
 // Licensed to the public under the Apache License 2.0.
 
-import { access, basename, stat } from 'fs';
+import { access, basename, readfile, stat } from 'fs';
 import { cursor } from 'uci';
 
 const template_directory = '/usr/share/ucode/luci/template';
@@ -179,7 +179,21 @@ export default function(env) {
 	self.env.media = media;
 	self.env.theme = basename(media);
 	self.env.resource = uci.get('luci', 'main', 'resourcebase');
-	self.env.pkgs_update_time = stat('/lib/apk/db/installed')?.mtime ?? stat('/usr/lib/opkg/status')?.mtime ?? 0;
+
+	/* Package database timestamps can remain identical between reproducible
+	 * sysupgrade images. Use the identity embedded in the read-only new image
+	 * so luci.js and every dynamically loaded view receive a new ?v= value. */
+	let build_version;
+	try {
+		let build = json(readfile('/rom/etc/zbt-mega-build.json'));
+		build_version = build?.version;
+	}
+	catch (e) {}
+
+	self.env.pkgs_update_time =
+		(type(build_version) == 'string' && match(build_version, /^[A-Za-z0-9._-]{1,80}$/))
+			? build_version
+			: (stat('/lib/apk/db/installed')?.mtime ?? stat('/usr/lib/opkg/status')?.mtime ?? 0);
 	self.env.include = (...args) => self.render_any(...args);
 
 	return self;
