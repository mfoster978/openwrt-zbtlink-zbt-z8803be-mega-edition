 # Method curl - Download file using curl
 # Usage: curl <URL>
 _curl() {
-  url=$1
-  # timeout 10s
-  res=$(curl --connect-timeout 10 --max-time 15 --interface "$NET_DEV" "$url" -o /dev/null --silent --show-error)
-  status=$?
-  if [ "$status" -ne 0 ]; then
-    log "Curl failed: $res"
-  fi
-  return $status
+    local url http_code status
+    url=$1
+    # Curl considers HTTP errors and redirects successful transfers. Capture
+    # the response code so captive portals cannot masquerade as connectivity.
+    http_code=$(curl --connect-timeout 10 --max-time 15 \
+        --interface "$NET_DEV" --output /dev/null --silent --show-error \
+        --write-out '%{http_code}' "$url")
+    status=$?
+    if [ "$status" -ne 0 ]; then
+        log "Curl failed: exit=$status http=${http_code:-000}"
+        return "$status"
+    fi
+
+    case "$http_code" in
+        [0-9][0-9][0-9]) ;;
+        *)
+            log "HTTP probe returned invalid status: ${http_code:-empty}"
+            return 1
+            ;;
+    esac
+
+    case "$url" in
+        *generate_204*)
+            [ "$http_code" = 204 ] || {
+                log "HTTP probe expected 204, got $http_code"
+                return 1
+            }
+            ;;
+        *)
+            case "$http_code" in
+                2??|3??) ;;
+                *)
+                    log "HTTP probe expected 2xx/3xx, got $http_code"
+                    return 1
+                    ;;
+            esac
+            ;;
+    esac
+    return 0
 }
 
