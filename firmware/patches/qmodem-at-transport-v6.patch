+// One inode per character device, never unlinked while a waiter may exist.
+// Kernel-owned locks are released even if rpcd kills a timed-out AT request.
+static int at_lock_fd = -1;
+
+int lock_at_port(char* filename) {
+    struct stat device;
+    char lock_path[128];
+    struct timespec began, now;
+    if (!filename || stat(filename, &device) != 0 || !S_ISCHR(device.st_mode))
+        return -1;
+    snprintf(lock_path, sizeof(lock_path), "/var/lock/tom-modem-%u-%u.lock",
+             major(device.st_rdev), minor(device.st_rdev));
+    at_lock_fd = open(lock_path, O_CREAT | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (at_lock_fd < 0) return -1;
+    clock_gettime(CLOCK_MONOTONIC, &began);
+    for (;;) {
+        if (flock(at_lock_fd, LOCK_EX | LOCK_NB) == 0) return 0;
+        if (errno != EWOULDBLOCK && errno != EAGAIN && errno != EINTR) break;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        if (now.tv_sec - began.tv_sec >= 10) {
+            err_msg("AT port busy: timed out waiting for its current request");
+            break;
+        }
+        usleep(20000);
+    }
+    close(at_lock_fd);
+    at_lock_fd = -1;
+    return -1;
+}
+
+int unlock_at_port(char* filename __attribute__((unused))) {
+    if (at_lock_fd >= 0) {
+        close(at_lock_fd);
+        at_lock_fd = -1;
+    }
     return 0;
 }
 
