+# Quectel separates the 5G deployment selector from the SA/NSA band masks.
+# Querying is read-only; setting the already-active mode deliberately performs
+# no modem write. This keeps the UI reversible without rewriting band lists.
+zbt_5g_deployment_query()
+{
+    local response value
+
+    case "$(printf '%s' "$manufacturer" | tr '[:upper:]' '[:lower:]')" in
+        *quectel*) ;;
+        *) return 1 ;;
+    esac
+
+    response=$(at "$at_port" 'AT+QNWPREFCFG="nr5g_disable_mode"') || return 1
+    printf '%s\n' "$response" | grep -q '^[[:space:]]*OK[[:space:]]*$' || return 1
+    printf '%s\n' "$response" | grep -Eq '^[[:space:]]*(ERROR|\+CM[ES] ERROR:|NO CARRIER)' && return 1
+    value=$(printf '%s\n' "$response" | sed -n 's/^[[:space:]]*+QNWPREFCFG:[[:space:]]*"nr5g_disable_mode",[[:space:]]*\([012]\)[[:space:]\r]*$/\1/p' | sed -n '1p')
+    [ -n "$value" ] || return 1
+    printf '%s\n' "$value"
+}
+
+zbt_5g_deployment_name()
+{
+    case "$1" in
+        0) printf '%s\n' auto ;;
+        1) printf '%s\n' nsa ;;
+        2) printf '%s\n' sa ;;
+        *) return 1 ;;
+    esac
+}
+
+zbt_5g_deployment_value()
+{
+    case "$1" in
+        auto) printf '%s\n' 0 ;;
+        nsa) printf '%s\n' 1 ;;
+        sa) printf '%s\n' 2 ;;
+        *) return 1 ;;
+    esac
+}
+
+zbt_get_5g_deployment()
+{
+    local value mode
+
+    json_init
+    json_add_object deployment
+    if value=$(zbt_5g_deployment_query) && mode=$(zbt_5g_deployment_name "$value"); then
+        json_add_string supported 1
+        json_add_string mode "$mode"
+        json_add_string value "$value"
+    else
+        json_add_string supported 0
+        json_add_string message 'This modem did not return a supported Quectel 5G deployment setting.'
+    fi
+    json_close_object
+    json_dump
+}
+
+zbt_set_5g_deployment()
+{
+    local requested="$1" desired current response actual
+
+    json_init
+    json_add_object result
+    if ! desired=$(zbt_5g_deployment_value "$requested"); then
+        json_add_string status 0
+        json_add_string message 'Invalid 5G deployment mode.'
+    elif ! current=$(zbt_5g_deployment_query); then
+        json_add_string status 0
+        json_add_string message 'Unable to read a supported Quectel 5G deployment setting; no change was made.'
+    elif [ "$current" = "$desired" ]; then
+        json_add_string status 1
+        json_add_string mode "$requested"
+        json_add_string changed 0
+        json_add_string message 'The requested mode is already active; no modem write was needed.'
+    else
+        response=$(at "$at_port" "AT+QNWPREFCFG=\"nr5g_disable_mode\",$desired")
+        if printf '%s\n' "$response" | grep -q '^[[:space:]]*OK[[:space:]]*$' &&
+           actual=$(zbt_5g_deployment_query) && [ "$actual" = "$desired" ]; then
+            json_add_string status 1
+            json_add_string mode "$requested"
+            json_add_string changed 1
+            json_add_string message '5G deployment mode changed and verified.'
+        else
+            json_add_string status 0
+            json_add_string message 'The modem did not confirm the requested mode; its band masks were not changed.'
+        fi
+    fi
+    json_close_object
+    json_dump
+}
