diff --git a/modules/luci-base/ucode/dispatcher.uc b/modules/luci-base/ucode/dispatcher.uc
--- a/modules/luci-base/ucode/dispatcher.uc
+++ b/modules/luci-base/ucode/dispatcher.uc
@@ -20,6 +20,26 @@ let indexcache = "/tmp/luci-indexcache";
 
 let http, runtime, tree, luabridge;
 
+function root_password_is_unset() {
+	let fd = open('/etc/shadow', 'r');
+
+	if (!fd)
+		return false;
+
+	for (let line = fd.read('line'); line; line = fd.read('line')) {
+		let fields = split(line, ':');
+
+		if (fields[0] == 'root') {
+			let password = fields[1] ?? '';
+			fd.close();
+			return !length(password) || password == '!' || password == '*' || substr(password, 0, 1) == '!';
+		}
+	}
+
+	fd.close();
+	return false;
+}
+
 function error404(msg) {
 	http.status(404, 'Not Found');
 
@@ -992,0 +1012,12 @@
+		/* A fresh Mega image has no shared default password. After the first
+		 * local login, keep every administration route behind the standard
+		 * password form until root receives a real password. The password RPC,
+		 * menu endpoint and static assets do not traverse this authenticated
+		 * branch, so the form remains usable. */
+		let requested_path = join('/', path ?? []);
+		if (resolved.ctx.authuser == 'root' && root_password_is_unset() &&
+		    requested_path != 'admin/system/admin/password' && requested_path != 'admin/logout') {
+			http.redirect(build_url('admin', 'system', 'admin', 'password') + '?first=1');
+			return;
+		}
+
