 {
+    local response token imsi
     case "$1" in
+        auto_preferred)
+            # The modem comparison that triggered this policy is direct
+            # T-Mobile US (310/260): NSA exposes LTE anchors plus NR carrier
+            # aggregation while its selected SA cell is severely congested.
+            # Use the subscriber identity only in memory; never return/log it.
+            response=$(at "$at_port" 'AT+CIMI' 2>/dev/null) || response=''
+            imsi=''
+            for token in $(printf '%s\n' "$response" | tr -d '\r'); do
+                case "$token" in *[!0-9]*) continue ;; esac
+                [ "${#token}" -ge 14 ] && [ "${#token}" -le 16 ] || continue
+                imsi=$token
+                break
+            done
+            case "$imsi" in 310260*) printf '%s\n' 1 ;; *) printf '%s\n' 0 ;; esac
